FROM python:3.9-slim

WORKDIR /app

ENV PYTHONPATH=/app

RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

COPY ui/ ./ui/
COPY src/ ./src/

RUN mkdir -p artifacts reports/figures

EXPOSE 8501

ARG API_URL=https://cyclesense-yjca.onrender.com
ENV API_URL=${API_URL}

HEALTHCHECK CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "ui/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true", "--server.fileWatcherType=none"]