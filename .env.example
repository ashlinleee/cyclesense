# CycleSense Environment Variables

# API Configuration
API_URL=http://localhost:8000

# Docker Configuration
DOCKER_COMPOSE=false

# Render Configuration (for production)
RENDER_API_KEY=your_render_api_key
RENDER_BACKEND_SERVICE_ID=your_backend_service_id
RENDER_FRONTEND_SERVICE_ID=your_frontend_service_id
RENDER_BACKEND_WEBHOOK=your_backend_webhook_url
RENDER_FRONTEND_WEBHOOK=your_frontend_webhook_url

# GitHub Secrets Reference
# GITHUB_TOKEN: Automatically provided by GitHub Actions
# API_URL: Backend API URL (e.g., https://cyclesense-api.onrender.com)
# FRONTEND_URL: Frontend URL (e.g., https://cyclesense-frontend.onrender.com)
